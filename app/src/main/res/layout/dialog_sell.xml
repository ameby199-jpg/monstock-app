<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvAvailableStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvUnitPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/accent"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvTotalPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="19sp"
        android:textColor="@color/accent"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnMinus"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="-"
            android:textSize="20sp"
            android:backgroundTint="?attr/colorPrimary" />

        <EditText
            android:id="@+id/etQuantitySold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:hint="@string/quantity"
            android:inputType="number"
            android:textSize="18sp"
            android:layout_marginHorizontal="8dp" />

        <Button
            android:id="@+id/btnPlus"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="+"
            android:textSize="20sp"
            android:backgroundTint="?attr/colorPrimary" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profil client"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/llCustomerProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvProfileMan"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:textSize="24sp"
            android:text="👨🏿"
            android:background="@drawable/bg_profile_selected" />

        <TextView
            android:id="@+id/tvProfileWoman"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:textSize="24sp"
            android:text="👩🏿" />

        <TextView
            android:id="@+id/tvProfileBoy"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:textSize="24sp"
            android:text="👦🏿" />

        <TextView
            android:id="@+id/tvProfileGirl"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="24sp"
            android:text="👧🏿" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mode de paiement"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgPayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💵  Espèces"
            android:textSize="15sp"
            android:buttonTint="@color/cash"
            android:checked="true"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/rbOrangeMoney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟠  Orange Money"
            android:textSize="15sp"
            android:buttonTint="@color/orange_money"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/rbWave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔵  Wave"
            android:textSize="15sp"
            android:buttonTint="@color/wave"
            android:padding="8dp" />

    </RadioGroup>

    <Button
        android:id="@+id/btnSellNow"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="18dp"
        android:text="✅  VENDRE"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnOrderSingle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🕑 Commande"
            android:textSize="13sp"
            android:backgroundTint="?attr/colorPrimary"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛒 Panier"
            android:textSize="13sp"
            android:backgroundTint="#9E9E9E" />

    </LinearLayout>

</LinearLayout>
