<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <EditText
        android:id="@+id/etQuantitySold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/quantity"
        android:inputType="number" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mode de paiement"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgPayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💵  Espèces"
            android:textSize="15sp"
            android:buttonTint="@color/cash"
            android:checked="true"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/rbOrangeMoney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟠  Orange Money"
            android:textSize="15sp"
            android:buttonTint="@color/orange_money"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/rbWave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔵  Wave"
            android:textSize="15sp"
            android:buttonTint="@color/wave"
            android:padding="8dp" />

    </RadioGroup>

</LinearLayout>
