<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvAvailableStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/primary"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnMinus"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="−"
            android:textSize="20sp"
            android:backgroundTint="@color/primary" />

        <EditText
            android:id="@+id/etQuantitySold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:hint="@string/quantity"
            android:inputType="number"
            android:textSize="18sp"
            android:layout_marginHorizontal="8dp" />

        <Button
            android:id="@+id/btnPlus"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="+"
            android:textSize="20sp"
            android:backgroundTint="@color/primary" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mode de paiement"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgPayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💵  Espèces"
            android:textSize="15sp"
            android:buttonTint="@color/cash"
            android:checked="true"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/rbOrangeMoney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟠  Orange Money"
            android:textSize="15sp"
            android:buttonTint="@color/orange_money"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/rbWave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔵  Wave"
            android:textSize="15sp"
            android:buttonTint="@color/wave"
            android:padding="8dp" />

    </RadioGroup>

</LinearLayout>
