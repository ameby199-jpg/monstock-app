<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/optBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🖼  Fond d'écran de cet écran"
        android:textSize="16sp"
        android:padding="16dp" />

    <TextView
        android:id="@+id/optTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎨  Couleur du thème"
        android:textSize="16sp"
        android:padding="16dp" />

    <TextView
        android:id="@+id/optNameColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔤  Couleur du nom des produits"
        android:textSize="16sp"
        android:padding="16dp" />

    <TextView
        android:id="@+id/optPriceColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💰  Couleur des prix"
        android:textSize="16sp"
        android:padding="16dp" />

    <TextView
        android:id="@+id/optOrdersColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏰  Couleur du bouton commandes"
        android:textSize="16sp"
        android:padding="16dp" />

</LinearLayout>
