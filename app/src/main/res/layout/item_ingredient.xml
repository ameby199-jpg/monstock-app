<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvName"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:background="@drawable/cell_bg_name"
        android:padding="10dp"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvStockActuel"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:background="@drawable/cell_bg_stock"
        android:padding="10dp"
        android:textSize="13sp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvAchat"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:background="@drawable/cell_bg_achat"
        android:padding="10dp"
        android:textSize="13sp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvChiffres"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:background="@drawable/cell_bg_chiffres"
        android:padding="10dp"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNouveauStock"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:background="@drawable/cell_bg_nouveau"
        android:padding="10dp"
        android:textSize="13sp"
        android:textColor="@color/black"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:background="@drawable/cell_bg_name"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null" />
    </LinearLayout>

</LinearLayout>
