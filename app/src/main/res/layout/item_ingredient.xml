<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/row_divider_bg"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tvName"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="95dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:textSize="13sp"
        android:textColor="@color/primary" />

    <TextView
        android:id="@+id/tvStockActuel"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:textSize="13sp"
        android:textColor="@color/col_stock" />

    <TextView
        android:id="@+id/tvStockPresent"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:textSize="13sp"
        android:textColor="@color/col_present" />

    <TextView
        android:id="@+id/tvAchat"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:textSize="13sp"
        android:textColor="@color/col_achat" />

    <TextView
        android:id="@+id/tvDepense"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:textSize="13sp"
        android:textColor="@color/col_depense" />

    <LinearLayout
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null" />
    </LinearLayout>

</LinearLayout>
